{
  "name": "catchment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint src server mcp",
    "typecheck": "tsc -b",
    "dev:server": "node --env-file-if-exists=../.env --watch server/main.ts",
    "start": "node server/main.ts",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp": "node dist-mcp/catchment-mcp.js"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^5.24.1",
    "openai": "^7.59.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
